{
  "name": "mathsachs",
  "private": true,
  "version": "0.1.23",
  "type": "module",
  "description": "Mathsachs — a fast, modern mental-math practice web app.",
  "author": "Linus und Matthias Ulrich",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:start": "electron .",
    "electron:dev": "concurrently -k -n vite,electron \"npm:dev\" \"wait-on tcp:127.0.0.1:5173 && electron .\"",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder --publish never",
    "electron:dist:linux": "npm run build && electron-builder --linux --publish never",
    "electron:dist:win": "npm run build && electron-builder --win --publish never",
    "electron:dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^10.0.5",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^2.0.5",
    "wait-on": "^9.1.0"
  }
}
